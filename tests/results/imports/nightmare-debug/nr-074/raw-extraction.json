      "steps": [
        {
          "id": "s1",
          "text": "Preheat the oven to 350°F. Butter or spray a 9×13-inch baking pan with baking spray, then line it with parchment paper.",
          "ingredientRefs": []
        },
        {
          "id": "s2",
          "text": "In a medium bowl, whisk together the flour, espresso powder, cornstarch, baking soda, and salt.",
          "ingredientRefs": []
        },
        {
          "id": "s3",
          "text": "In a large mixing bowl, combine the brown sugar, granulated sugar, melted butter, eggs, spiced rum, and vanilla. Whisk together until the mixture is thick and well combined.",
          "ingredientRefs": []
        },
        {
          "id": "s4",
          "text": "Add the flour mixture to the butter mixture and stir with a silicone spatula until almost combined. Add the chocolate chips and stir until they are well distributed.",
          "ingredientRefs": []
        },
        {
          "id": "s5",
          "text": "Transfer the dough to the prepared baking pan and spread it into an even layer.",
          "ingredientRefs": []
        },
        {
          "id": "s6",
          "text": "Bake for 30 to 32 minutes or until the edges are set and golden brown and a toothpick inserted into the center comes out with a few moist crumbs. Let the cookie bars cool completely in the pan.",
          "ingredientRefs": []
        }
      ]
    },
    {
      "name": "For the Mascarpone Frosting:",
      "ingredients": [],
      "steps": [
        {
          "id": "s7",
          "text": "Meanwhile, in the bowl of a stand mixer fitted with a paddle attachment (or a large bowl, using a handheld mixer), cream the mascarpone, butter and salt together on medium speed for about 1 minute or until creamy.",
          "ingredientRefs": []
        },
        {
          "id": "s8",
          "text": "Add the spiced rum, and vanilla and sift in the confectioners’ sugar. Beat on low speed for about 30 seconds, just until combined.",
          "ingredientRefs": []
        },
        {
          "id": "s9",
          "text": "Increase the speed to medium and beat for about 2 to 3 minutes, until the frosting is light and fluffy.",
          "ingredientRefs": []
        },
        {
          "id": "s10",
          "text": "Spread the frosting in a thin, even layer over top of the cooled blondies. Refrigerate for at least 30 minutes (up to 2 days) to help the frosting set.",
          "ingredientRefs": []
        },
        {
          "id": "s11",
          "text": "One hour before serving, dust the blondies all over with cocoa powder. Slice and serve.",
          "ingredientRefs": []
        }
      ]
    }
  ],
