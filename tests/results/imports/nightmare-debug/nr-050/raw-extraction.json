      "steps": [
        {
          "id": "s1",
          "text": "Heat {i1} in a large pot over medium heat. Add {i2}, {i3}, and several grinds of {i10} and sauté until soft, 5 to 8 minutes.",
          "ingredientRefs": [
            "i1",
            "i2",
            "i3",
            "i10"
          ]
        },
        {
          "id": "s2",
          "text": "Add {i4} and cook until it begins to soften, stirring occasionally, for 8 to 10 minutes.",
          "ingredientRefs": [
            "i4"
          ]
        },
        {
          "id": "s3",
          "text": "Add {i5}, {i6}, {i7}, and {i8}. Stir and cook 30 seconds to 1 minute, until fragrant, then add 3 cups of {i9}.",
          "ingredientRefs": [
            "i5",
            "i6",
            "i7",
            "i8",
            "i9"
          ]
        },
        {
          "id": "s4",
          "text": "Bring to a boil, cover, and reduce heat to a simmer. Cook until the squash is tender, 20 to 30 minutes.",
          "ingredientRefs": []
        },
        {
          "id": "s5",
          "text": "Let cool slightly and pour the soup into a blender, working in batches if necessary, and blend until smooth. If your soup is too thick, add up to 1 cup more broth and blend.",
          "ingredientRefs": []
        },
        {
          "id": "s6",
          "text": "Season to taste and serve with chopped parsley, toasted pepitas, and crusty bread.",
          "ingredientRefs": []
