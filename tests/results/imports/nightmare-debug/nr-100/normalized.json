      "steps": [
        {
          "id": "s1",
          "text": "Preheat the oven to 375ºF. Add {i1}, {i2}, {i3}, {i4}, 1/4 tsp smoked paprika, cayenne, {i8}, and pepper to a sauce pot. Bring the mixture to a boil over medium-high heat, whisking occasionally.",
          "ingredientRefs": [
            "i1",
            "i2",
            "i3",
            "i4",
            "i8"
          ]
        },
        {
          "id": "s2",
          "text": "Once boiling, turn the heat down to medium and allow the mixture to simmer for 7 minutes, whisking often, to reduce.",
          "ingredientRefs": []
        },
        {
          "id": "s3",
          "text": "Remove the sauce from the heat. In a separate bowl, combine the shredded {i9} and {i10}. Reserve about 1/4 of the cheese mix to use as a layer in the casserole dish. Add the remaining cheeses to the sauce a handful at a time, whisking it into the sauce until fully melted before adding more. Continue whisking in the cheese until all of it has been added and the sauce is smooth. Set the sauce aside (whisk occasionally to prevent a skin from forming).",
          "ingredientRefs": [
            "i9",
            "i10"
          ]
        },
        {
          "id": "s4",
          "text": "Bring a large pot of water to a boil for the macaroni. Once boiling, add the macaroni and boil just until tender (about 7 minutes). Drain the macaroni in a colander.",
          "ingredientRefs": []
        },
        {
          "id": "s5",
          "text": "While {i11} is boiling, make {i13}. Melt {i12} in a small skillet over medium heat. Once melted, add the Panko, {i3}, {i4}, 1/4 tsp smoked paprika, {i8}, and pepper. Stir and cook for about 3 minutes, or just until the breadcrumbs begin to toast. Remove the breadcrumbs from the heat and allow them to cool slightly.",
          "ingredientRefs": [
            "i3",
            "i4",
            "i8",
            "i11",
            "i12",
            "i13"
          ]
        },
        {
          "id": "s6",
          "text": "Stir the drained {i11} into the cheese sauce until well combined. Grease an 8x8-inch baking dish.",
          "ingredientRefs": [
            "i11"
          ]
        },
        {
          "id": "s7",
          "text": "Layer half of {i11} into the baking dish. Sprinkle the reserved shredded cheese mixture over the macaroni. Layer the second half of the macaroni over the cheese.",
          "ingredientRefs": [
            "i11"
          ]
        },
        {
          "id": "s8",
          "text": "Combine the cooled {i13} with the remaining 1/4 cup shredded cheddar cheese, then sprinkle over top {i11} and cheese.",
          "ingredientRefs": [
            "i11",
            "i13"
          ]
        },
        {
          "id": "s9",
          "text": "Bake {i11} and cheese in the preheated oven for about 20 minutes or until the cheese is bubbling up around the edges and {i13} on top are golden brown. Allow the mac and cheese to cool for about 5 minutes before serving.",
          "ingredientRefs": [
            "i11",
            "i13"
          ]
        }
      ]
