      "steps": [
        {
          "id": "s1",
          "text": "Two to three days before roasting: Begin thawing {i1} in the refrigerator or in a cooler kept at 38 degrees F.",
          "ingredientRefs": [
            "i1"
          ]
        },
        {
          "id": "s2",
          "text": "Combine {i4}, {i2}, {i3}, {i5}, {i6}, and {i7} in a large stockpot over medium-high heat. Stir occasionally to dissolve solids and bring to a boil. Then remove the brine from the heat, cool to room temperature, and refrigerate.",
          "ingredientRefs": [
            "i2",
            "i3",
            "i4",
            "i5",
            "i6",
            "i7"
          ]
        },
        {
          "id": "s3",
          "text": "The night before or early on the day you'd like to eat: Combine the brine, {i12} and ice in the 5-gallon bucket. Place the thawed {i1} (with innards removed) breast side down in brine. If necessary, weigh down the bird to ensure it is fully immersed, cover, and refrigerate or set in cool area for 8 to 16 hours, turning the bird once half way through brining.",
          "ingredientRefs": [
            "i1",
            "i12"
          ]
        },
        {
          "id": "s4",
          "text": "Preheat the oven to 500 degrees F. Remove the bird from brine and rinse inside and out with cold {i12}. Discard the brine.",
          "ingredientRefs": [
            "i12"
          ]
        },
        {
          "id": "s5",
          "text": "Place the bird on roasting rack inside a half sheet pan and pat dry with paper towels.",
          "ingredientRefs": []
        },
        {
          "id": "s6",
          "text": "Combine the apple, onion, {i11}, and 1 cup of water in a microwave safe dish and microwave on high for 5 minutes. Add steeped aromatics to {i1}'s cavity along with {i13} and {i14}. Tuck the wings underneath the bird and coat the skin liberally with canola oil.",
          "ingredientRefs": [
            "i1",
            "i11",
            "i13",
            "i14"
          ]
        },
        {
          "id": "s7",
          "text": "Roast {i1} on lowest level of the oven at 500 degrees F for 30 minutes. Insert a probe thermometer into thickest part of the breast and reduce the oven temperature to 350 degrees F. Set the thermometer alarm (if available) to 161 degrees F. A 14 to 16 pound bird should require a total of 2 to 2 1/2 hours of roasting. Let the turkey rest, loosely covered with foil or a large mixing bowl for 15 minutes before carving.",
          "ingredientRefs": [
            "i1"
          ]
        }
      ]
    }
