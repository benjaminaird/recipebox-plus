      "steps": [
        {
          "id": "s1",
          "text": "Gather all ingredients.",
          "ingredientRefs": []
        },
        {
          "id": "s2",
          "text": "Crumble {i1} into a skillet set over medium-high heat. Cook and stir until no longer pink. Remove from the heat and set aside.",
          "ingredientRefs": [
            "i1"
          ]
        },
        {
          "id": "s3",
          "text": "Fill a large pot halfway with water (about 8 cups) and bring to a boil.",
          "ingredientRefs": []
        },
        {
          "id": "s4",
          "text": "Add {i1} to pot, cover pot, and return to a boil. Add beets and simmer for 10 minutes. Add carrots and potatoes and continue to cook until potatoes are tender, about 10 minutes more. Stir in cabbage and tomatoes.",
          "ingredientRefs": [
            "i1"
          ]
        },
        {
          "id": "s5",
          "text": "Heat oil in a skillet over medium heat. Add {i8} and cook until tender. Stir in {i9} and remaining 3/4 cup water until well blended; transfer to the pot.",
          "ingredientRefs": [
            "i8",
            "i9"
          ]
        },
        {
          "id": "s6",
          "text": "Add garlic to the soup, cover, and turn off the heat. Let stand 5 minutes. Stir in sugar and season with salt and pepper.",
          "ingredientRefs": []
        },
