      "steps": [
        {
          "id": "s1",
          "text": "Heat {i1} in a large lidded skillet over medium heat. Add {i2} and {i3} and cook for 5 to 8 minutes, or until softened.",
          "ingredientRefs": [
            "i1",
            "i2",
            "i3"
          ]
        },
        {
          "id": "s2",
          "text": "Add {i4}, {i5}, {i6}, and {i7}, if using, and cook, stirring, for 30 seconds, or until fragrant.",
          "ingredientRefs": [
            "i4",
            "i5",
            "i6",
            "i7"
          ]
        },
        {
          "id": "s3",
          "text": "Add {i8}, {i9}, and several grinds of {i10}. Simmer over low heat, stirring often, for 15 minutes, or until the sauce has thickened.",
          "ingredientRefs": [
            "i8",
            "i9",
            "i10"
          ]
        },
        {
          "id": "s4",
          "text": "Make 6 wells in the sauce and crack one {i11} into each well. Cover and cook until the eggs are set, 4 to 8 minutes. The timing will depend on how runny or firm you like your eggs.",
          "ingredientRefs": [
            "i11"
          ]
        },
        {
          "id": "s5",
          "text": "Season to taste with salt and pepper and top with {i12} and {i13}. Serve with {i14}.",
          "ingredientRefs": [
            "i12",
            "i13",
            "i14"
          ]
        }
