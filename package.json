{
  "name": "recipebox",
  "version": "1.1.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:core": "node scripts/build-core.js",
    "core:check": "node scripts/build-core.js --check",
    "build:app": "npm run build:core && npx --yes esbuild@0.20.2 src/app.jsx --jsx=transform --minify --target=es2020 --legal-comments=none --outfile=public/app.js",
    "build:recipebox": "npm run build:app",
    "shopping-list-test": "node scripts/shopping-list-test.js",
    "notes-import-test": "node scripts/notes-import-test.js",
    "import-fidelity-test": "node scripts/import-fidelity-test.js",
    "recipe-tags-test": "node scripts/recipe-tags-test.js",
    "library-view-test": "node scripts/library-view-test.js",
    "meal-plan-test": "node scripts/meal-plan-test.js",
    "ai-credits-test": "node scripts/ai-credits-test.js",
    "entitlements-test": "node scripts/entitlements-test.js",
    "import-reliability-test": "node scripts/import-reliability-test.js",
    "auth-rate-limit-test": "node scripts/auth-rate-limit-test.js",
    "request-guards-test": "node scripts/request-guards-test.js",
    "import-test:estimate": "node scripts/import-test/run.js --estimate",
    "import-test:run": "node scripts/import-test/run.js --run",
    "import-test:analyze": "node scripts/import-test/analyze.js",
    "import-test:compare": "node scripts/import-test/compare.js",
    "import-test:gate": "node scripts/import-test/gate.js",
    "test:imports:nightmare": "node scripts/nightmare-import-test.js",
    "smoke-test": "node scripts/smoke-test.js",
    "security-smoke-test": "node scripts/security-smoke-test.js",
    "youtube-parser-test": "node scripts/youtube-parser-test.js",
    "auth-verification-test": "node scripts/auth-verification-test.js",
    "device-auth-test": "node scripts/device-auth-test.js",
    "device-auth-routes-test": "node scripts/device-auth-routes-test.js",
    "native-auth-e2e-test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/native-auth-e2e-test.mjs",
    "security-headers-test": "node scripts/security-headers-test.js",
    "security-hardening-test": "node scripts/security-hardening-test.js",
    "nutrition-test": "node scripts/nutrition-test.js",
    "recipe-library-test": "node scripts/recipe-library-test.js",
    "import-extract-test": "node scripts/import-extract-test.js",
    "nightmare-report-test": "node scripts/nightmare-report-test.js",
    "scraper-fallback-test": "node scripts/scraper-fallback-test.js",
    "grounding-test": "node scripts/grounding-test.js",
    "recipe-schema-test": "node scripts/recipe-schema-test.js",
    "household-test": "node scripts/household-test.js",
    "normalize-test": "node scripts/normalize-test.js",
    "recipe-save-test": "node scripts/recipe-save-test.js",
    "recipe-persistence-test": "node scripts/recipe-persistence-test.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.5",
    "youtube-transcript": "^1.3.1",
    "youtubei.js": "^17.0.1"
  }
}
