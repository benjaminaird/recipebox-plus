{
  "expo": {
    "name": "RecipeBox",
    "slug": "recipebox",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.benjaminaird.recipebox.dev",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2B5B45",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.benjaminaird.recipebox.dev"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F6F5F1",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#141413"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2B5B45",
          "sounds": [
            "./assets/sounds/chime.wav",
            "./assets/sounds/bell.wav",
            "./assets/sounds/ring.wav"
          ],
          "defaultChannel": "timers-chime"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "notes": "Design-system test build. Provisional identifiers (.dev); the permanent bundle identifier is not yet chosen. No auth, database, AI or sync.",
      "eas": {
        "projectId": "06ab1d4f-79eb-4e7b-8e55-fc94b5ef2c56"
      }
    },
    "owner": "benjaminaird"
  }
}
