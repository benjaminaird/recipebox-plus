{ "title":"Oatmeal Raisin Cookies",
  "ingredients":["1 cup unsalted butter softened","1 cup packed brown sugar","1/2 cup granulated sugar","2 large eggs","1 teaspoon vanilla extract","1 1/2 cups all-purpose flour","1 teaspoon baking soda","1 teaspoon ground cinnamon","1/2 teaspoon salt","3 cups old-fashioned rolled oats","1 cup raisins"],
  "steps":["Preheat oven to 350F and line baking sheets","Cream butter and sugars until fluffy","Beat in eggs then vanilla","Whisk flour baking soda cinnamon salt and stir in","Fold in oats and raisins","Drop tablespoons and bake 11 minutes","Cool on sheet then rack"] }
