{
  "appId": "com.recipeboxapp.recipebox",
  "appName": "RecipeBox",
  "webDir": "public",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2200,
      "backgroundColor": "#234B32",
      "showSpinner": false
    },
    "Keyboard": {
      "resize": "body"
    }
  }
}
